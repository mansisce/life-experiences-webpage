NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=littlehuman123
PORT=3001

# Eventbrite — get a free key at https://www.eventbrite.com/platform/api
EVENTBRITE_TOKEN=

# Meetup — OAuth2 client credentials from https://secure.meetup.com/meetup_api/oauth_consumers/
# Use "Server Flow" to get a long-lived access token
MEETUP_KEY=

# Groq — FREE primary LLM (Llama 3.3 70B, 100k tokens/day)
# Get a free key at https://console.groq.com/ → API Keys
GROQ_API_KEY=

# Gemini Flash — FREE fallback when Groq hits daily limit (1500 req/day)
# Get a free key at https://aistudio.google.com/ → Get API key
GEMINI_API_KEY=

# Apify — for scraping Instagram posts from followed accounts
# Get a free token at https://console.apify.com/account/integrations
# Free tier gives ~$5/month of compute (enough for weekly Instagram sync)
APIFY_TOKEN=

# Cache live events for this many minutes (default 60)
LIVE_CACHE_TTL_MIN=60
