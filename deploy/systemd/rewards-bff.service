[Unit]
Description=Rewards BFF (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=rewards
Group=rewards
WorkingDirectory=/opt/rewards/services/bff
EnvironmentFile=/etc/rewards/bff.env
# One worker: SQLite has a single writer. Startup runs the Alembic migrations (with a backup first).
ExecStart=/opt/rewards/services/bff/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/rewards

[Install]
WantedBy=multi-user.target
