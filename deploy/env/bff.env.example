# Copy to /etc/rewards/bff.env on the droplet (owner root, mode 600). Read by rewards-bff and the backup timers.
BFF_ENV=production
# Random values. Generate each with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BFF_DEMO_TOKEN must equal VITE_BFF_TOKEN in the Rewards Vercel project and BFF_TOKEN in dashboard.env.
BFF_DEMO_TOKEN=change-me
BFF_SIGNING_KEY=change-me
BFF_DATABASE_URL=sqlite+aiosqlite:////var/lib/rewards/rewards.db
BFF_PHOTO_DIR=/var/lib/rewards/photos
BFF_FILES_DIR=/var/lib/rewards/files
BFF_TIMEZONE=Asia/Kolkata
# The personal site (embedded #/rewards) and the standalone Rewards app both call the API.
# Keep the single quotes: they protect the JSON double quotes from bash and systemd.
BFF_CORS_ORIGINS='["https://mansilly.vercel.app","https://<mfe-project>.vercel.app"]'
