{
  "name": "mansilly-monorepo",
  "version": "1.0.0",
  "description": "Mansilly - Personal & Professional Operating System",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "preview": "pnpm -r run preview",
    "lint": "pnpm -r run lint",
    "host": "pnpm -F @mansilly/host dev",
    "personal-os": "pnpm -F @mansilly/personal-os dev",
    "professional": "pnpm -F @mansilly/professional dev",
    "reward-system": "pnpm -F @mansilly/reward-system dev"
  },
  "devDependencies": {
    "turbo": "^1.10.0"
  }
}
